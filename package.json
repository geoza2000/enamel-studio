  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "polygon-clipping": "0.15.7",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "firebase-tools": "15.32.0",
    "vite": "8.3.1"
  }
}
