{
  "name": "enamel-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser-based 3D enamel badge designer",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build --base=./",
    "preview": "vite preview --host 127.0.0.1",
